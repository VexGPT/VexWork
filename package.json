{
  "name": "@vexgpt/vexwork",
  "version": "0.1.0-foundation",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test",
    "check": "node scripts/work-check.mjs",
    "dashboard:build": "node scripts/build-public-dashboard.mjs",
    "dashboard:check": "node scripts/build-public-dashboard.mjs --check",
    "work:status": "node scripts/work-status.mjs",
    "review:deterministic": "npm run test:coverage && npm run check && npm run dashboard:check && npm run workspace:check",
    "review": "npm run review:deterministic",
    "workspace:build": "node scripts/build-public-workspace.mjs",
    "workspace:check": "node scripts/build-public-workspace.mjs --check",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20.1"
  }
}
