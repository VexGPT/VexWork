      "definitionPath": "projects/vexwork-foundation/project.json",
      "boardViewPath": "projects/vexwork-foundation/board.view.json",
      "agencyPolicyPathOrNull": null
    },
    {
      "projectRef": "project.vexstream.mobile-library",
      "workgraphRef": "workgraph.vexwork.foundation",
      "definitionPath": "projects/vexstream-mobile-library/project.json",
      "boardViewPath": "projects/vexstream-mobile-library/board.view.json",
      "agencyPolicyPathOrNull": "projects/vexstream-mobile-library/agency.policy.json"
    }
  ]
}
