{
  "schemaVersion": "vexwork.project-registry/v1",
  "registryRef": "registry.vexwork.projects.001",
  "registryVersion": 2,
  "purpose": "Locate source-managed Projects and their Workgraph, Board, and optional agency-policy sources without making the registry another owner of work state.",
  "projects": [
    {
      "projectRef": "project.vexwork.foundation",
