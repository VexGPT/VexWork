  "pathways": [
    {
      "pathwayRef": "pathway.theme-mode.select",
      "label": "Choose Light / Dark",
      "disposition": "SCAE_FAMILY",
      "summary": "A UI toggle becomes a Family Control. The Family admits State immediately and requests a Save; the Store result returns through the same Family before presentation changes.",
      "returns": "The same Dark mode toggle reads darkModeControlChecked from the returned presentation.",
      "returnRef": "theme.render",
      "nodes": [
        { "ref": "theme.intent", "face": "BEHAVIOR", "role": "INTENT", "label": "invoke(AppActions.ToggleDarkMode)", "symbol": "action.theme.dark-mode.toggle", "summary": "The element names an application action. It does not save or mutate State.", "source": "app:runtime/AppActions.kt", "code": "val ToggleDarkMode = ActionKey(\"action.theme.dark-mode.toggle\")" },
        { "ref": "theme.runtime", "face": "BEHAVIOR", "role": "DISPATCH", "label": "VexRuntime → AppActionRegistrations.dispatch", "symbol": "ElementIntent.Invoke", "summary": "Runtime interprets the Invoke intent and looks up the one registered owner for the ActionKey.", "source": "app:runtime/VexRuntime.kt", "code": "is ElementIntent.Invoke ->\n    appActions.dispatch(AppActionRequest(action = intent.action, ...))" },
        { "ref": "theme.registration", "face": "BEHAVIOR", "role": "DISPATCH", "label": "appAction(ToggleDarkMode) { toggleDarkMode() }", "symbol": "DebugMenuScreen.appActionRegistrations", "summary": "Screen-local registration calls the closure captured when the session was constructed.", "source": "app:screens/shared/debug/DebugMenuScreen.kt", "code": "appAction(action = AppActions.ToggleDarkMode, ownerRef = screenId) {\n    toggleDarkMode()\n}" },
        { "ref": "theme.toggle", "face": "BEHAVIOR", "role": "DISPATCH", "label": "toggleThemeMode(family, store, root, logger)", "symbol": "VexLifeSession.toggleThemeMode", "summary": "Reads family.currentState and picks the next mode: NotSet or Light becomes Dark; Dark becomes Light.", "source": "app:ui/VexLifeSession.kt" },
        { "ref": "theme.control", "face": "BEHAVIOR", "role": "CONTROL", "label": "Control.Select(Parameter.Mode)", "symbol": "ThemeModeFamily.Control.Select", "summary": "Family-owned semantic input. The same Parameter instance travels into the Effect and the Method.", "source": "app:ui/ThemeMode.kt", "code": "data class Select(val mode: Parameter.Mode) : Control" },
        { "ref": "theme.state", "face": "BEHAVIOR", "role": "STATE", "label": "CURRENT State · ThemeMode", "symbol": "ThemeMode.NotSet | Light | Dark", "summary": "Exact current semantic truth that act() reads.", "source": "app:ui/ThemeMode.kt" },
        { "ref": "theme.act", "face": "BEHAVIOR", "role": "ACT", "label": "ThemeModeFamily.act(State, Control)", "symbol": "VexFamily.activate", "summary": "Pure. Authors the accepted Act and claims nothing about persistence.", "source": "app:ui/ThemeMode.kt", "code": "val resolved = act(currentState, control) ?: return null\naccepted.admittedState?.let(::setCurrentStateLocked)" },
        { "ref": "theme.admitted", "face": "BEHAVIOR", "role": "STATE", "label": "admitted State · selected mode", "symbol": "accepted.admittedState", "summary": "Semantic State updates now, while the Save is only requested.", "source": "arch:behavior/src/main/kotlin/com/vextreme/vexlife/android/behavior/VexFamily.kt" },
        { "ref": "theme.effect", "face": "BEHAVIOR", "role": "EFFECT", "label": "Begin(Effect.Save, Latest)", "symbol": "ThemeModeFamily.Effect.Save", "summary": "Inert request for outside work. Latest means a newer Save supersedes an older one.", "source": "app:ui/ThemeMode.kt", "code": "data class Save(val mode: Parameter.Mode) : Effect" },
        { "ref": "theme.display", "face": "BEHAVIOR", "role": "PROJECTION", "label": "DisplayState → VexThemePresentation", "symbol": "ThemeModeFamily.displayStateFor", "summary": "The Family decides presentation meaning; Compose only manifests it.", "source": "app:ui/ThemeMode.kt", "code": "data object Dark : DisplayState {\n    override val presentation = VexThemePresentation.Dark\n}" },
        { "ref": "theme.render", "face": "BEHAVIOR", "role": "PROJECTION", "label": "VexLifeTheme + toggle checked", "symbol": "themePresentation.darkModeControlChecked", "summary": "The same Debug Menu toggle reads the presentation that returned through the system.", "source": "app:ui/VexLifeTheme.kt" },
        { "ref": "theme.method", "face": "DEPTH", "role": "METHOD", "label": "Act.Method.Save(store, same Parameter)", "symbol": "ThemeModeFamily.Act.Method.Save", "summary": "Fully bound: the real Store plus the semantic Parameter. Nothing downstream reconstructs them.", "source": "app:ui/ThemeMode.kt", "code": "override suspend fun invoke() = store.save(parameter.mode)" },
        { "ref": "theme.launch", "face": "DEPTH", "role": "EXECUTION", "label": "act.launchWith(executionRoot).method(…)", "symbol": "activateThemeMode", "summary": "Transports the owner, Approach and RelationshipId the Act already authored.", "source": "app:ui/ThemeMode.kt" },
        { "ref": "theme.custody", "face": "DEPTH", "role": "EXECUTION", "label": "VexExecution · Job custody (Latest)", "symbol": "VexExecution", "summary": "Owns which Jobs are alive and how they overlap. It does not decide feature meaning.", "source": "arch:execution/src/main/kotlin/com/vextreme/vexlife/android/execution/VexExecution.kt" },
        { "ref": "theme.store", "face": "DEPTH", "role": "STORE", "label": "ThemeModeStore.save(mode)", "symbol": "ThemeModeStore", "summary": "Boundary to independently owned outside truth.", "source": "app:ui/ThemeModeStore.kt" },
