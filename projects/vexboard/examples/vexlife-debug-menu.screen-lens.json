    { "ref": "note.control.select-drift", "subjectRef": "theme.control", "text": "Board drift", "detail": "Current ThemeMode.kt names this Control.Select(Parameter.Mode). The older 'Debug Menu / Theme Mode' Origin-walk board still labels it Control.Toggle." },
    { "ref": "note.admitted.before-save", "subjectRef": "theme.admitted", "text": "State before Store", "detail": "Semantic State may already be Dark while persistence is still only requested. Accepting intention does not claim Store success." },
    { "ref": "note.fence.local", "subjectRef": "theme.fence", "text": "ThemeMode-local", "detail": "This === currentness fence is earned by ThemeMode. It is not a universal token pattern for other Families." },
    { "ref": "note.log.beside", "subjectRef": "theme.log", "text": "Beside the path", "detail": "Chronology observes facts as owners learn them. Removing the logger changes no behavior." },
    { "ref": "note.shell.one-owner", "subjectRef": "element.shell.fab-cluster", "text": "One owner, many screens", "detail": "AppShell defines these routes once. AppFrame shows them on every PRIMARY screen, so the Screen map draws one route group instead of copying it under Home, Events and Settings." },
    { "ref": "note.reset.no-family", "subjectRef": "pathway.log-history.clear", "text": "No Behavior earned", "detail": "Clearing has no State-dependent meaning today. A Family would earn its place only if clear needed confirmation, undo, or reuse by another Control." },
    { "ref": "note.debug.composition", "subjectRef": "screen.debug-menu", "text": "Composition surface", "detail": "Debug Menu composes developer controls to rightful owners. It does not own Events, ThemeMode or log semantics." }
